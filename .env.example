# OwnerFieldOps — copy to .env and configure owner sign-in before starting.
# Owner access fails closed until this is at least 16 characters.
OFO_OWNER_PASSWORD=
# Loopback is the default. Deliberately change this only for a network deployment.
OFO_BIND_HOST=127.0.0.1
# For a reverse proxy, set its exact HTTPS origin; do not include a trailing slash.
OFO_PUBLIC_ORIGIN=

# Port the app runs on (default 4820)
PORT=4820

# --- Stripe (payment links) ---
# If set, "Generate payment link" on an invoice creates a real Stripe payment link.
# If not set, you can always paste any payment link manually.
STRIPE_SECRET_KEY=

# --- Twilio (SMS sending) ---
# If set, automations and review requests can send real SMS.
# If not set, everything runs in Dry Run and is logged to the Send Log instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (SMTP sending) ---
# If set, automations and review requests can send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Business <you@example.com>"
