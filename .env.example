# OwnerFieldOps — optional integrations.
# The app works fully WITHOUT any of these. Copy to .env and fill in only what you use.

# Port the app runs on (default 4820)
PORT=4820

# --- Stripe (payment links) ---
# If set, "Generate payment link" on an invoice creates a real Stripe payment link.
# If not set, you can always paste any payment link manually.
STRIPE_SECRET_KEY=

# --- Twilio (SMS sending) ---
# If set, automations and review requests can send real SMS.
# If not set, everything runs in Dry Run and is logged to the Send Log instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (SMTP sending) ---
# If set, automations and review requests can send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Business <you@example.com>"
