# OwnerFieldOps — optional integrations.
# The app works fully WITHOUT any of these. Copy to .env and fill in only what you use.

# Port the app runs on (default 4820)
PORT=4820

# --- Reverse proxy (only if you put one in front of the app) ---
# Out of the box the app listens directly and this must stay unset.
# Rate limiting counts requests per visitor IP. Behind nginx/Caddy/Cloudflare
# every request arrives from the proxy instead, so without this setting all of
# your customers share one bucket and one busy visitor can lock everyone out.
# Set it to the NUMBER of proxies in front of the app:
#   TRUST_PROXY=1   one nginx / Caddy in front
#   TRUST_PROXY=2   Cloudflare -> nginx -> app
# ...or to a comma-separated list of trusted proxy addresses/CIDRs.
# Do NOT use TRUST_PROXY=true unless you know why: it trusts whatever
# X-Forwarded-For a client sends, which lets anyone skip the rate limit.
TRUST_PROXY=

# --- Stripe (payment links) ---
# If set, "Generate payment link" on an invoice creates a real Stripe payment link.
# If not set, you can always paste any payment link manually.
STRIPE_SECRET_KEY=

# --- Twilio (SMS sending) ---
# If set, automations and review requests can send real SMS.
# If not set, everything runs in Dry Run and is logged to the Send Log instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (SMTP sending) ---
# If set, automations and review requests can send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Business <you@example.com>"
